{
  "name": "nova-imperium-website",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation website of Nova Imperium (Astro Starlight), built from okf/ and docs/",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "pnpm sync && astro dev",
    "build": "pnpm sync && astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/starlight": "0.42.11",
    "astro": "7.4.11",
    "astro-mermaid": "2.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "mermaid": "12.3.0",
    "starlight-links-validator": "0.27.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
