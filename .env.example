# Copy to `.env` with docker/init-env.sh and fill in. `.env` is not committed.
# All variables with explanations: docs/configuration.md

# --- Required ------------------------------------------------------------------

# The address players open, as your reverse proxy serves it (https:// in
# production; the session cookie is then marked Secure). Used in invitation links.
NOVA_PUBLIC_URL=

# --- Mail for invitations (optional) -------------------------------------------
# Without SMTP_HOST no mail is sent: the admin copies the invitation link.
# The password is NOT set here: write it into secrets/smtp_password.
# Optional extra sign-in check sent to the registered address. Requires SMTP.
NOVA_EMAIL_LOGIN_CODES=0
SMTP_HOST=
SMTP_PORT=
# true = TLS from the start (port 465), starttls = STARTTLS required (port 587),
# false = no encryption (only for a mail sink on the same machine)
SMTP_TLS=true
SMTP_USERNAME=
MAIL_FROM=

# --- Optional (defaults in brackets) --------------------------------------------
# NOVA_WEB_PUSH=0                    set 1 to enable Web Push (requires HTTPS)
# NOVA_VERSION=latest                 image tag, for example 26.11.0
# NOVA_BIND=127.0.0.1                 address the port listens on, for your proxy
# NOVA_HTTP_PORT=8080                 port of the game on the host
# NOVA_TRUSTED_PROXIES=private_ranges addresses of your proxy (X-Forwarded-For is believed)
# NOVA_SESSION_DAYS=30                days a login stays valid (1 to 365)
NOVA_PASSWORD_MIN_LENGTH=15         # Minimum length for new passwords (8 to 200)
# NOVA_INVITE_DAYS=7                  days an invitation link stays valid (1 to 30)
# NOVA_RATE_LIMIT_ATTEMPTS=20         logins, registrations and invitation checks per address and window
# NOVA_RATE_LIMIT_MINUTES=10          length of that window in minutes
