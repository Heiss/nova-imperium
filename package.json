{
  "name": "nova-imperium",
  "version": "0.0.0",
  "private": true,
  "description": "Classic space strategy browser game for a small group of friends, self-hosted with Docker",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "cli": "node src/server/cli.ts",
    "build": "vite build",
    "lint": "eslint .",
    "lint:dead": "knip --no-progress",
    "lint:dupes": "jscpd src scripts .github/scripts",
    "lint:deps": "depcruise src e2e scripts --config .dependency-cruiser.cjs --output-type err",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "MIGRATION_RUNS=10 stryker run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm lint:dead && pnpm lint:dupes && pnpm lint:deps && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "better-sqlite3": "13.0.3",
    "markdown-it": "15.0.3",
    "nodemailer": "10.4.0",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
