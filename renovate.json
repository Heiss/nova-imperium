{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "packageRules": [
      {
        "description": "Security pull requests merge themselves for patch updates (owner, 2026-11-13, #148).",
        "matchUpdateTypes": ["patch"],
        "automerge": true
      },
      {
        "description": "Minor security updates merge themselves from version 1.0 on; below 1.0 a minor update counts like a major one and waits for the owner (#148).",
        "matchUpdateTypes": ["minor"],
        "matchCurrentVersion": ">=1.0.0",
        "automerge": true
      }
    ]
  },
  "customManagers": [
    {
      "description": "Images run by `docker run` in the CI (gitleaks, Trivy, actionlint), pinned to their digests.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "(?<depName>zricethezav/gitleaks|aquasec/trivy|rhysd/actionlint):(?<currentValue>v?[0-9][0-9.]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "zizmor, run by pipx in the CI.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "pipx run (?<depName>zizmor)==(?<currentValue>[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
